{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "t2w-app",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-09-07",
  "compatibility_flags": ["nodejs_compat"],
  "containers": [
    {
      "class_name": "T2WContainer",
      "image": "./Dockerfile",
      "max_instances": 1,
      "instance_type": "lite",
      "constraints": { "regions": ["OC", "APAC"] }
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "T2W_CONTAINER", "class_name": "T2WContainer" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["T2WContainer"] }
  ],
  "observability": { "enabled": true },
  "vars": {
    "T2W_ADMIN_USER": "admin",
    "T2W_ADMIN_FULL_NAME": "Administrator",
    "T2W_AUTH_DOMAIN": "t2w.invalid"
  },
  "secrets": {
    "required": [
      "DATABASE_URL",
      "SUPABASE_URL",
      "SUPABASE_PUBLISHABLE_KEY",
      "SUPABASE_SECRET_KEY",
      "T2W_SESSION_SECRET",
      "T2W_ADMIN_PASS"
    ]
  }
}
